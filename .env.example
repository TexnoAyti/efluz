# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Telegram Bot Token from @BotFather for validating WebApp initData
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# TELEGRAM_WELCOME_STICKER_FILE_ID: Optional Telegram file_id of the welcome sticker sent on /start
TELEGRAM_WELCOME_STICKER_FILE_ID=""

# TELEGRAM_GROUP_USERNAME: The official Telegram group required for club claiming (default: @efleagueuz)
TELEGRAM_GROUP_USERNAME="@efleagueuz"

# TELEGRAM_WEBHOOK_SECRET: Optional secret token for verifying incoming Telegram webhook updates
TELEGRAM_WEBHOOK_SECRET=""

# TELEGRAM_WEBAPP_URL: URL opened by the Telegram Bot /start WebApp button
TELEGRAM_WEBAPP_URL="https://efluz.vercel.app"

# ADMIN_TELEGRAM_IDS: Comma-separated Telegram User IDs with admin access
ADMIN_TELEGRAM_IDS="123456789,987654321"

# ENABLE_DEV_AUTH: Set to "true" in development mode to enable the sandbox user switcher
ENABLE_DEV_AUTH="true"

# FIREBASE CONFIGURATION (For Vercel Production Persistence)
FIREBASE_PROJECT_ID="gen-lang-client-0195097895"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@gen-lang-client-0195097895.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIRESTORE_DATABASE_ID="ai-studio-efluz-4c6c88a6-697e-4fdf-82ed-45fec68ca34d"
# FIREBASE_SERVICE_ACCOUNT_JSON: Alternative single-line JSON string containing the full service account credentials
FIREBASE_SERVICE_ACCOUNT_JSON=""

# UPSTASH REDIS CONFIGURATION (For Durable Read Model Cache)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"
