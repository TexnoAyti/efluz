+/* EFL UZ Premium Football Broadcast Design Tokens (Light & Dark)
+   Strictly scoped to .efl-preview (Admin-only preview gating) */
+
+.efl-preview {
+  /* Cohesive Broadcast Light Mode Palette */
+  --efl-bg: #f4f5f7;
+  --efl-surface: #ffffff;
+  --efl-surface-2: #eef1f5;
+  --efl-border: #e2e6ec;
+
+  --efl-text: #111827;
+  --efl-text-2: #667085;
+  --efl-muted: #98a2b3;
+
+  --efl-brand: #1e3a8a;
+  --efl-primary: #2563eb;
+  --efl-primary-strong: #1d4ed8;
+  --efl-primary-soft: #eff6ff;
+
+  --efl-success: #10b981;
+  --efl-danger: #ef4444;
+  --efl-warning: #f59e0b;
+  --efl-info: #2563eb;
+
+  --efl-shadow: 0 2px 8px rgba(17, 24, 39, 0.04), 0 1px 2px rgba(17, 24, 39, 0.02);
+  --efl-shadow-lg: 0 10px 25px -5px rgba(17, 24, 39, 0.06), 0 4px 10px -4px rgba(17, 24, 39, 0.03);
+
+  /* Legacy fallback bindings for sub-components */
+  --preview-accent: var(--efl-primary);
+  --preview-on-accent: #ffffff;
+  --preview-soft: var(--efl-primary-soft);
+  --preview-bg: var(--efl-bg);
+  --preview-panel: var(--efl-surface);
+  --preview-raised: var(--efl-surface-2);
+  --preview-border: var(--efl-border);
+  --preview-ink: var(--efl-text);
+  --preview-muted: var(--efl-text-2);
+  --preview-shadow: rgba(17, 24, 39, 0.06);
+
+  background: var(--efl-bg) !important;
+  color: var(--efl-text);
+  color-scheme: light;
+}
+
+/* Cohesive Broadcast Dark Mode Palette */
+.efl-preview.theme-dark {
+  --efl-bg: #080b12;
+  --efl-surface: #111722;
+  --efl-surface-2: #171e2c;
+  --efl-border: rgba(255, 255, 255, 0.08);
+
+  --efl-text: #f8fafc;
+  --efl-text-2: #94a3b8;
+  --efl-muted: #64748b;
+
+  --efl-brand: #3b82f6;
+  --efl-primary: #3b82f6;
+  --efl-primary-strong: #2563eb;
+  --efl-primary-soft: rgba(59, 130, 246, 0.14);
+
+  --efl-success: #10b981;
+  --efl-danger: #ef4444;
+  --efl-warning: #f59e0b;
+  --efl-info: #3b82f6;
+
+  --efl-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
+  --efl-shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.55);
+
+  --preview-accent: var(--efl-primary);
+  --preview-on-accent: #ffffff;
+  --preview-soft: var(--efl-primary-soft);
+  --preview-bg: var(--efl-bg);
+  --preview-panel: var(--efl-surface);
+  --preview-raised: var(--efl-surface-2);
+  --preview-border: var(--efl-border);
+  --preview-ink: var(--efl-text);
+  --preview-muted: var(--efl-text-2);
+  --preview-shadow: rgba(0, 0, 0, 0.5);
+
+  background: var(--efl-bg) !important;
+  color: var(--efl-text);
+  color-scheme: dark;
+}
+
+/* Explicit Light Mode class */
+.efl-preview.theme-light {
+  background: var(--efl-bg) !important;
+  color: var(--efl-text);
+  color-scheme: light;
+}
+
+/* Tabular Numbers for Football Scores and Timers */
+.efl-preview .tabular-nums {
+  font-variant-numeric: tabular-nums;
+}
+
+/* Main Container Sizing and Bottom Padding for floating nav */
+.efl-preview main {
+  max-width: 820px;
+  padding-top: 12px;
+  padding-bottom: 96px;
+}
+
+/* App Header in Broadcast Redesign */
+.efl-preview .preview-app-header {
+  background: var(--efl-surface);
+  border-bottom: 1px solid var(--efl-border);
+  color: var(--efl-text);
+  box-shadow: 0 1px 3px rgba(17, 24, 39, 0.04);
+}
+
+.efl-preview .preview-brand-logo {
+  width: 110px;
+  height: 38px;
+  display: flex;
+  align-items: center;
+}
+
+.efl-preview .preview-brand-logo img {
+  width: 100%;
+  height: 100%;
+  object-fit: contain;
+  object-position: left center;
+}
+
+.efl-preview .preview-logo-dark { display: none; }
+.efl-preview .preview-logo-light { display: block; }
+.efl-preview.theme-dark .preview-logo-dark { display: block; }
+.efl-preview.theme-dark .preview-logo-light { display: none; }
+
+/* Header Action Buttons */
+.efl-preview .preview-search-trigger,
+.efl-preview .preview-theme-toggle,
+.efl-preview .preview-nav-btn {
+  background: var(--efl-surface-2);
+  border: 1px solid var(--efl-border);
+  color: var(--efl-text);
+}
+
+.efl-preview .preview-search-trigger:hover,
+.efl-preview .preview-theme-toggle:hover,
+.efl-preview .preview-nav-btn:hover {
+  background: var(--efl-primary-soft);
+  color: var(--efl-primary);
+}
+
+/* Apple Liquid Glass Bottom Navigation */
+.efl-preview .liquid-glass-nav {
+  position: relative;
+  border-radius: 9999px;
+  backdrop-filter: blur(28px) saturate(190%);
+  -webkit-backdrop-filter: blur(28px) saturate(190%);
+  background: rgba(255, 255, 255, 0.88);
+  border: 1px solid rgba(226, 230, 236, 0.95);
+  box-shadow:
+    0 16px 36px rgba(17, 24, 39, 0.08),
+    0 3px 10px rgba(17, 24, 39, 0.03),
+    inset 0 1px 1.5px rgba(255, 255, 255, 0.95),
+    inset 0 -1px 1px rgba(226, 230, 236, 0.6);
+  transition: all 180ms ease;
+}
+
+.efl-preview.theme-dark .liquid-glass-nav {
+  background: rgba(17, 23, 34, 0.86);
+  border: 1px solid rgba(255, 255, 255, 0.1);
+  box-shadow:
+    0 18px 42px rgba(0, 0, 0, 0.55),
+    0 4px 14px rgba(0, 0, 0, 0.25),
+    inset 0 1px 1.5px rgba(255, 255, 255, 0.18),
+    inset 0 -1px 1px rgba(0, 0, 0, 0.4);
+}
+
+/* Subtle Specular Refraction Arc on Top of Capsule */
+.efl-preview .liquid-glass-nav::before {
+  content: "";
+  position: absolute;
+  top: 0;
+  left: 15%;
+  right: 15%;
+  height: 1px;
+  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.8), transparent);
+  pointer-events: none;
+}
+
+.efl-preview.theme-dark .liquid-glass-nav::before {
+  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
+}
+
+/* Active Icon Highlight within Liquid Glass */
+.efl-preview .liquid-nav-active {
+  color: var(--efl-primary) !important;
+}
+
+/* Broadcast Card and Surface Presets */
+.efl-preview .preview-surface,
+.efl-preview .glass-panel,
+.efl-preview .glass-card {
+  background: var(--efl-surface) !important;
+  border-color: var(--efl-border) !important;
+  color: var(--efl-text) !important;
+  box-shadow: var(--efl-shadow) !important;
+}
+
+.efl-preview .preview-surface-elevated {
+  background: var(--efl-surface-2) !important;
+  border-color: var(--efl-border) !important;
+  color: var(--efl-text) !important;
+}
+
+.efl-preview .glass-button {
+  background: var(--efl-surface-2) !important;
+  border-color: var(--efl-border) !important;
+  color: var(--efl-text) !important;
+}
+
+.efl-preview .glass-button:hover {
+  background: var(--efl-primary-soft) !important;
+  color: var(--efl-primary) !important;
+}
+
+/* Primary Button in Admin Broadcast (Cobalt Blue instead of legacy mint) */
+.efl-preview .btn-glass-primary {
+  background: var(--efl-primary) !important;
+  color: #ffffff !important;
+  border: 1px solid transparent !important;
+  box-shadow: 0 2px 8px rgba(37, 99, 235, 0.25) !important;
+  border-radius: 0.75rem !important;
+  transition: all 150ms ease !important;
+}
+
+.efl-preview .btn-glass-primary:hover {
+  background: var(--efl-primary-strong) !important;
+  transform: translateY(-1px);
+}
+
+.efl-preview .btn-glass-primary:active {
+  transform: scale(0.98);
+}
+
+/* Inputs in Admin Broadcast */
+.efl-preview .glass-input {
+  background: var(--efl-surface-2) !important;
+  border: 1px solid var(--efl-border) !important;
+  color: var(--efl-text) !important;
+}
+
+.efl-preview .glass-input::placeholder {
+  color: var(--efl-muted) !important;
+}
+
+.efl-preview .glass-input:focus {
+  border-color: var(--efl-primary) !important;
+  outline: none;
+  box-shadow: 0 0 0 2px var(--efl-primary-soft) !important;
+}
+
