{
  "version": 2,
  "regions": ["fra1"],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api|api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/telegram-worker",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{public/export-emblems/*.svg,node_modules/dejavu-fonts-ttf/{package.json,ttf/DejaVuSans{,-Bold}.ttf},node_modules/@napi-rs/canvas-linux-x64-gnu/*.node}",
      "maxDuration": 60
    }
  }
}
