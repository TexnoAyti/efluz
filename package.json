{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && tsx src/server/buildAssets.ts && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild src/server/apiEntry.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=api/index.js && tsx src/server/tests/deploymentSelfCheck.ts",
    "build:assets": "tsx src/server/buildAssets.ts",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "verify:roster-2026-27": "tsx src/server/tests/verifyRoster202627.ts",
    "validate:season-2026-27": "tsx src/server/tests/validateSeason202627.ts",
    "test:tournament": "tsx src/server/tests/runAllTests.ts",
    "test:adversarial": "tsx src/server/tests/adversarialTestSuite.ts",
    "test:strict-proof": "tsx src/server/tests/strictVerificationProof.ts",
    "test:smoke": "tsx src/server/tests/productionSmokeTest.ts",
    "test:telegram-webapp": "tsx src/server/tests/telegramWebAppTest.ts",
    "test:vercel": "tsx src/server/tests/verifyVercelApiHandler.ts",
    "test:firebase-persistence": "tsx src/server/tests/firebasePersistenceTest.ts",
    "test:production-data-consistency": "tsx src/server/tests/productionDataConsistencyTest.ts",
    "test:full-production-firestore-audit": "tsx src/server/tests/fullProductionFirestoreAudit.ts",
    "test:tournament-architecture": "tsx src/server/tests/verifyTournamentArchitecture.ts",
    "test:standings": "tsx src/server/tests/standingsPreaggregationTest.ts",
    "test:ucl32-locking": "tsx src/server/tests/verifyUCL32AndMatchdayLocking.ts",
    "test:deployment-selfcheck": "tsx src/server/tests/deploymentSelfCheck.ts",
    "test:quota-audit": "tsx src/server/tests/verifyQuotaResilienceAudit.ts",
    "test:firestore-guard": "tsx src/server/tests/firestoreReadGuardTest.ts",
    "test:sqlite-standings-fallback": "tsx src/server/tests/sqliteStandingsFallbackTest.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase-admin": "^14.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/sql.js": "^1.4.11",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
